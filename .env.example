# AI / Simulation Mode
# Set to 'false' to strictly call real external APIs, or 'true' to use the deterministic offline engine
DEMO_MODE=true

# Merchant Configuration
MERCHANT_NAME=Apex Retail India Pvt Ltd
MERCHANT_CURRENCY=INR
MERCHANT_ID=merch_apex_001
